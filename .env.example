# Recipe Chest — environment variables
# Copy to .env (local) or set them in Vercel: Project Settings → Environment Variables.

# The access code users enter to unlock the app
ACCESS_CODE=

# Random string used to sign the session cookie
SESSION_SECRET=

# API key from https://console.groq.com
GROQ_API_KEY=

# Optional: text model override (default: qwen/qwen3.8-27b)
GROQ_MODEL=

# Optional: vision model for image imports (default: same as GROQ_MODEL)
GROQ_VISION_MODEL=

# API key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Bearer secret for the Gmail import endpoint (/api/import-email).
# Must equal RECIPE_IMPORT_SECRET in the Apps Script properties.
EMAIL_IMPORT_SECRET=

# Upstash Redis (the code also accepts KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Debug: set to 1 to log raw AI output in the photo import
DEBUG_AI=

# Long random string. Lets the weekly Apps Script backup read /api/export
# without a browser session. Leave blank to disable the bearer path.
BACKUP_SECRET=

# The storage limit of your Upstash plan in MB, e.g. 256. Leave unset if you
# do not know it: the Storage panel simply omits the percentage.
STORAGE_CAP_MB=

# Optional: a second code that unlocks a read-only guest view
GUEST_CODE=

# Off by default. Set to 1 to show a "Browse as guest" button that gives
# read-only access with no code. Anyone with the URL can then read all recipes
# and photos. Remove it or set it to anything else to turn it off; existing
# guest sessions stop working at once unless GUEST_CODE is also set.
GUEST_OPEN=

# Optional: daily cap on AI tool calls across all users (default 100)
AI_DAILY_LIMIT=

# Optional: the public origin, used in emails and share links behind a proxy
PUBLIC_BASE_URL=

# Apps Script properties, set in the script editor (Project Settings -> Script
# Properties). They are not Vercel variables.
#   Code.gs   RECIPE_IMPORT_API_URL   the deployed /api/import-email URL
#   Code.gs   RECIPE_IMPORT_SECRET    must equal EMAIL_IMPORT_SECRET above
#   Backup.gs BACKUP_API_URL          the deployed /api/export URL
#   Backup.gs BACKUP_SECRET           must equal BACKUP_SECRET above
#   Backup.gs BACKUP_FOLDER_NAME      optional Drive folder name
#   Backup.gs BACKUP_KEEP_WEEKS       optional, default 8
#   Backup.gs BACKUP_NOTIFY_EMAIL     optional, defaults to your own address
